<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" 
    android:layout_height="wrap_content"
    android:background="@drawable/nm_dialog_bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="25dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="文 墨 书 香 阁"
            android:textColor="#4E5D6A"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="🔍 全网搜书"
            android:textColor="#27AE60"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_novel_search"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/selector_neumorph_btn"
            android:text="全 网 小 说 检 索"
            android:singleLine="true"
            android:textColor="#555555"
            android:textSize="12sp"
            android:stateListAnimator="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="🌟 推荐神站"
            android:textColor="#4E5D6A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_novel_520"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/selector_neumorph_btn"
            android:text="520BOOK (无广告纯净版)"
            android:singleLine="true"
            android:textColor="#555555"
            android:textSize="12sp"
            android:stateListAnimator="@null" />

        <TextView
            android:id="@+id/btn_close_novel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="35dp"
            android:padding="10dp"
            android:text="返回仪表盘"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>