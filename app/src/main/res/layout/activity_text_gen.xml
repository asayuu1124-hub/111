<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDEDED"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔮 靈感文案萃取器"
        android:textColor="#333333"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="5dp"/>
    
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="點擊下方按鈕，自動從雲端獲取最新文案。"
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginBottom="25dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        
        <Button
            android:id="@+id/btn_hitokoto"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginRight="10dp"
            android:background="@drawable/selector_neumorph_btn"
            android:text="每日一言"
            android:textColor="#4A90E2"
            android:textStyle="bold" />
            
        <Button
            android:id="@+id/btn_tiangou"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="@drawable/selector_neumorph_btn"
            android:text="舔狗日記"
            android:textColor="#E74C3C"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="25dp"
        android:background="@drawable/nm_card_bg"
        android:padding="20dp">
        
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">
            <TextView
                android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="點擊上方按鈕獲取靈感..."
                android:textColor="#555555"
                android:textSize="16sp"
                android:lineSpacingExtra="8dp"/>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:orientation="horizontal">
        
        <Button
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginRight="10dp"
            android:background="@drawable/selector_neumorph_btn"
            android:text="返 回"
            android:textColor="#888888" />
            
        <Button
            android:id="@+id/btn_copy"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="2"
            android:background="@drawable/selector_neumorph_btn"
            android:text="一 鍵 複 製"
            android:textColor="#27AE60"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>