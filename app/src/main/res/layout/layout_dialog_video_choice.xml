<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" 
    android:layout_height="wrap_content"
    android:background="@drawable/nm_dialog_bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="25dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="影 视 航 站 楼"
            android:textColor="#4E5D6A"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="✨ 动漫专区"
            android:textColor="#4A90E2"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_site_huazi"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/selector_neumorph_btn"
            android:text="花 子 之 家"
            android:singleLine="true"
            android:textColor="#555555"
            android:textSize="12sp"
            android:stateListAnimator="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btn_site_skr"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginRight="12dp"
                android:background="@drawable/selector_neumorph_btn"
                android:text="樱之空"
                android:singleLine="true"
                android:textColor="#555555"
                android:textSize="11sp"
                android:stateListAnimator="@null" />
            <Button
                android:id="@+id/btn_site_fl"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/selector_neumorph_btn"
                android:text="风铃动漫"
                android:singleLine="true"
                android:textColor="#555555"
                android:textSize="11sp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="🎬 看剧专区"
            android:textColor="#4E5D6A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btn_site_fandazi"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginRight="12dp"
                android:background="@drawable/selector_neumorph_btn"
                android:text="饭搭子影视"
                android:singleLine="true"
                android:textColor="#555555"
                android:textSize="11sp"
                android:stateListAnimator="@null" />
            <Button
                android:id="@+id/btn_site_kptv"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/selector_neumorph_btn"
                android:text="看片TV"
                android:singleLine="true"
                android:textColor="#555555"
                android:textSize="11sp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_close_choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="35dp"
            android:padding="10dp"
            android:text="返回仪表盘"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>