<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nm_button_raised"
    android:descendantFocusability="afterDescendants">

    <RelativeLayout android:id="@+id/title_bar" android:layout_width="match_parent" android:layout_height="45dp">
        <View android:id="@+id/btn_drag" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="2dp" android:background="@android:drawable/ic_menu_compass" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentRight="true">
            <TextView android:id="@+id/btn_minimize" android:layout_width="45dp" android:layout_height="match_parent" android:gravity="center" android:text="—" android:textColor="#4E5D6A" android:textSize="18sp" android:clickable="true" />
            <TextView android:id="@+id/btn_close" android:layout_width="45dp" android:layout_height="match_parent" android:gravity="center" android:text="✕" android:textColor="#E74C3C" android:textSize="18sp" android:clickable="true" />
        </LinearLayout>
    </RelativeLayout>

    <ScrollView android:id="@+id/sidebar_scroll" android:layout_width="95dp" android:layout_height="match_parent" android:layout_below="@id/title_bar" android:scrollbars="none">
        <LinearLayout android:id="@+id/sidebar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/menu_translate" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="15dp" android:text="快捷翻译" android:textColor="#4E5D6A" android:clickable="true" />
            <TextView android:id="@+id/menu_shield" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="15dp" android:text="防窥装甲" android:textColor="#4E5D6A" android:clickable="true" />
            <TextView android:id="@+id/menu_monitor" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="15dp" android:text="性能探针" android:textColor="#4E5D6A" android:clickable="true" />
            <TextView android:id="@+id/menu_counter" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="15dp" android:text="记牌矩阵" android:textColor="#4E5D6A" android:clickable="true" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/ll_trans_card" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/title_bar" android:layout_toRightOf="@id/sidebar_scroll" android:layout_margin="8dp" android:background="@drawable/bg_neumorph_trans_card" android:orientation="vertical" android:padding="8dp" android:visibility="gone">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="3dp">
            <TextView android:id="@+id/tv_mode_toggle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="被动模式: ON" android:textColor="#4E5D6A" android:textSize="9sp" android:clickable="true" />
            <ImageView android:id="@+id/iv_copy_trans" android:layout_width="22dp" android:layout_height="22dp" android:layout_alignParentRight="true" android:src="@android:drawable/ic_menu_save" android:visibility="gone" />
        </RelativeLayout>
        
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="5dp">
            <Spinner android:id="@+id/spin_src_lang" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:background="@drawable/bg_neumorph_edit_inset" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" ➔ " android:textColor="#4E5D6A" android:layout_gravity="center_vertical" />
            <Spinner android:id="@+id/spin_tgt_lang" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:background="@drawable/bg_neumorph_edit_inset" />
        </LinearLayout>

        <EditText android:id="@+id/et_trans_input" android:layout_width="match_parent" android:layout_height="40dp" android:background="@drawable/bg_neumorph_edit_inset" android:hint="点此输入并回车..." android:paddingLeft="10dp" android:textColor="#333333" android:textSize="12sp" android:singleLine="true" android:imeOptions="actionSearch" android:inputType="text" android:shadowColor="#CC000000" android:shadowRadius="3" />
        <TextView android:id="@+id/tv_trans_result" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:background="@drawable/bg_neumorph_edit_inset" android:padding="8dp" android:text="等待剪贴板内容..." android:textColor="#333333" android:textSize="13sp" android:shadowColor="#CC000000" android:shadowDx="1.5" android:shadowDy="1.5" android:shadowRadius="5" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="窗口透明度:" android:textColor="#4E5D6A" android:textSize="9sp" />
        <SeekBar android:id="@+id/sb_trans_alpha" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255" android:progress="255" />
    </LinearLayout>

    <LinearLayout android:id="@+id/ll_shield_card" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/title_bar" android:layout_toRightOf="@id/sidebar_scroll" android:layout_margin="8dp" android:background="@drawable/bg_neumorph_trans_card" android:orientation="vertical" android:padding="12dp" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="全局防窥蔽日装甲" android:textColor="#333333" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_shield_toggle" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="10dp" android:background="@drawable/nm_button_raised" android:gravity="center" android:text="启动装甲: OFF" android:textColor="#4E5D6A" android:clickable="true" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="装甲暗度 (物理穿透):" android:textColor="#4E5D6A" android:textSize="11sp" />
        <SeekBar android:id="@+id/sb_shield_alpha" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255" android:progress="200" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="窗口整体透明度:" android:textColor="#4E5D6A" android:textSize="11sp" />
        <SeekBar android:id="@+id/sb_shield_window_alpha" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255" android:progress="255" />
    </LinearLayout>

    <LinearLayout android:id="@+id/ll_monitor_card" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/title_bar" android:layout_toRightOf="@id/sidebar_scroll" android:layout_margin="8dp" android:background="@drawable/bg_neumorph_trans_card" android:orientation="vertical" android:padding="12dp" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="系统性能实况探针" android:textColor="#333333" android:textSize="14sp" android:textStyle="bold" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/tv_monitor_cpu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="CPU 占用率: 正在读取..." android:textColor="#4E5D6A" android:textSize="12sp" />
                <TextView android:id="@+id/tv_monitor_ram" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="RAM 占用率: 正在读取..." android:textColor="#4E5D6A" android:textSize="12sp" />
                <TextView android:id="@+id/tv_monitor_rom" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="ROM 占用率: 正在读取..." android:textColor="#4E5D6A" android:textSize="12sp" />
                <TextView android:id="@+id/tv_monitor_battery" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="电池状态: 正在读取..." android:textColor="#4E5D6A" android:textSize="12sp" />
                <TextView android:id="@+id/tv_monitor_net_rx" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="下行速率: 0 KB/s" android:textColor="#4E5D6A" android:textSize="12sp" />
                <TextView android:id="@+id/tv_monitor_net_tx" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="上行速率: 0 KB/s" android:textColor="#4E5D6A" android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="窗口整体透明度:" android:textColor="#4E5D6A" android:textSize="11sp" />
        <SeekBar android:id="@+id/sb_monitor_window_alpha" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255" android:progress="255" />
    </LinearLayout>

    <LinearLayout android:id="@+id/ll_counter_card" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/title_bar" android:layout_toRightOf="@id/sidebar_scroll" android:layout_margin="8dp" android:background="@drawable/bg_neumorph_trans_card" android:orientation="vertical" android:padding="12dp" android:visibility="gone">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="记牌矩阵" android:textColor="#333333" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/btn_counter_mode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toLeftOf="@+id/btn_counter_reset" android:layout_marginRight="15dp" android:text="[ 模式: 扣除 - ]" android:textColor="#4E5D6A" android:textSize="12sp" android:clickable="true" />
            <TextView android:id="@+id/btn_counter_reset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentRight="true" android:text="[ 全局重置 ]" android:textColor="#E74C3C" android:textSize="12sp" android:clickable="true" />
        </RelativeLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:scrollbars="none">
            <LinearLayout android:id="@+id/ll_counter_grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="窗口整体透明度:" android:textColor="#4E5D6A" android:textSize="11sp" />
        <SeekBar android:id="@+id/sb_counter_window_alpha" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255" android:progress="255" />
    </LinearLayout>

    <View android:id="@+id/btn_resize" android:layout_width="45dp" android:layout_height="45dp" android:layout_alignParentRight="true" android:layout_alignParentBottom="true" android:background="@android:drawable/ic_menu_help" />
</RelativeLayout>
