<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDEDED">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/nm_card_bg"
            android:padding="15dp">
            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/btn_ai_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◀"
                    android:textColor="#888888"
                    android:textSize="16sp"
                    android:paddingRight="15dp"/>

                <TextView
                    android:id="@+id/btn_ai_menu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☰ 矩陣切換"
                    android:textColor="#4A90E2"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_ai_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="🧠 終端神經網路 ✎"
                android:textColor="#333333"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="5dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_ai_model"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flash ▼"
                    android:textColor="#8E44AD"
                    android:textSize="13sp"
                    android:layout_marginRight="10dp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_ai_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● 待命"
                    android:textColor="#27AE60"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>

        <ListView
            android:id="@+id/lv_chat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:transcriptMode="alwaysScroll"
            android:stackFromBottom="true"
            android:padding="10dp"
            android:clipToPadding="false"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/nm_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/et_ai_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/nm_input_inset"
                    android:hint="輸入指令或問題..."
                    android:padding="12dp"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:maxLines="4" />

                <Button
                    android:id="@+id/btn_ai_send"
                    android:layout_width="65dp"
                    android:layout_height="50dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/selector_neumorph_btn"
                    android:text="發送"
                    android:textColor="#16A085"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginLeft="5dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_toggle_think"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚪ 深度思考"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginRight="20dp"
                    android:padding="5dp" />

                <TextView
                    android:id="@+id/btn_toggle_search"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚪ 聯網模式"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="5dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:background="#EDEDED"
            android:orientation="vertical"
            android:clickable="true">
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="歷史神經鏈路"
                android:padding="20dp"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/nm_card_bg"/>

            <Button
                android:id="@+id/btn_new_session"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="15dp"
                android:background="@drawable/selector_neumorph_btn"
                android:text="＋ 啟動新鏈路 (New Chat)"
                android:textColor="#4A90E2"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/lv_sessions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#DDDDDD"
                android:dividerHeight="1px"/>
        </LinearLayout>

        <View
            android:id="@+id/view_drawer_dim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000" />
    </LinearLayout>

</FrameLayout>